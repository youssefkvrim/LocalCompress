# Supply-chain controls: exact pins, lockfile required, no install scripts.
# In the Safran environment, point `registry` at the internal npm mirror.
save-exact=true
package-lock=true
ignore-scripts=true
audit=true
fund=false
registry=https://artifacts.cloud.one.ad/repository/npm-group/
strict-ssl=false
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
